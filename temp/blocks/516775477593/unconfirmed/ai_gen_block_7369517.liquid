{% doc %}
  @prompt
    si te fijas el footer está diseñado ya lo que se ve opaco
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: linear-gradient(180deg, 
      {{ block.settings.bg_color_top }} 0%, 
      {{ block.settings.bg_color_bottom }} 100%);
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-footer-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      {{ block.settings.accent_color }} 50%, 
      transparent 100%);
    opacity: {{ block.settings.border_opacity | divided_by: 100.0 }};
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-footer-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-footer-links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    transition: all 0.3s ease;
    opacity: {{ block.settings.link_opacity | divided_by: 100.0 }};
    position: relative;
    padding-left: 0;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.accent_color }};
    opacity: 1;
    padding-left: 8px;
  }

  .ai-footer-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    opacity: {{ block.settings.text_opacity | divided_by: 100.0 }};
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.social_bg }};
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: {{ block.settings.social_radius }}px;
    color: {{ block.settings.accent_color }};
    text-decoration: none;
    transition: all 0.3s ease;
    opacity: {{ block.settings.social_opacity | divided_by: 100.0 }};
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.bg_color_bottom }};
    opacity: 1;
    transform: translateY(-2px);
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    border-top: 1px solid {{ block.settings.accent_color }};
    padding-top: 24px;
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    opacity: {{ block.settings.bottom_opacity | divided_by: 100.0 }};
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.copyright_size }}px;
  }

  .ai-footer-payment-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} {
    height: 24px;
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-footer-bottom-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-grid-{{ ai_gen_id }}">
      
      {% if block.settings.show_column_1 %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          {% if block.settings.column_1_title != blank %}
            <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.column_1_title }}</h3>
          {% endif %}
          {% if block.settings.column_1_text != blank %}
            <div class="ai-footer-text-{{ ai_gen_id }}">{{ block.settings.column_1_text }}</div>
          {% endif %}
          {% if block.settings.show_social %}
            <div class="ai-footer-social-{{ ai_gen_id }}">
              {% if block.settings.social_instagram != blank %}
                <a href="{{ block.settings.social_instagram }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>
              {% endif %}
              {% if block.settings.social_facebook != blank %}
                <a href="{{ block.settings.social_facebook }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </a>
              {% endif %}
              {% if block.settings.social_twitter != blank %}
                <a href="{{ block.settings.social_twitter }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Twitter">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                  </svg>
                </a>
              {% endif %}
              {% if block.settings.social_youtube != blank %}
                <a href="{{ block.settings.social_youtube }}" class="ai-footer-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                    <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                  </svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_column_2 %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          {% if block.settings.column_2_title != blank %}
            <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.column_2_title }}</h3>
          {% endif %}
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.link_2_1_text != blank and block.settings.link_2_1_url != blank %}
              <li><a href="{{ block.settings.link_2_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_2_1_text }}</a></li>
            {% endif %}
            {% if block.settings.link_2_2_text != blank and block.settings.link_2_2_url != blank %}
              <li><a href="{{ block.settings.link_2_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_2_2_text }}</a></li>
            {% endif %}
            {% if block.settings.link_2_3_text != blank and block.settings.link_2_3_url != blank %}
              <li><a href="{{ block.settings.link_2_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_2_3_text }}</a></li>
            {% endif %}
            {% if block.settings.link_2_4_text != blank and block.settings.link_2_4_url != blank %}
              <li><a href="{{ block.settings.link_2_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_2_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_column_3 %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          {% if block.settings.column_3_title != blank %}
            <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.column_3_title }}</h3>
          {% endif %}
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.link_3_1_text != blank and block.settings.link_3_1_url != blank %}
              <li><a href="{{ block.settings.link_3_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_3_1_text }}</a></li>
            {% endif %}
            {% if block.settings.link_3_2_text != blank and block.settings.link_3_2_url != blank %}
              <li><a href="{{ block.settings.link_3_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_3_2_text }}</a></li>
            {% endif %}
            {% if block.settings.link_3_3_text != blank and block.settings.link_3_3_url != blank %}
              <li><a href="{{ block.settings.link_3_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_3_3_text }}</a></li>
            {% endif %}
            {% if block.settings.link_3_4_text != blank and block.settings.link_3_4_url != blank %}
              <li><a href="{{ block.settings.link_3_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_3_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_column_4 %}
        <div class="ai-footer-column-{{ ai_gen_id }}">
          {% if block.settings.column_4_title != blank %}
            <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.column_4_title }}</h3>
          {% endif %}
          <ul class="ai-footer-links-{{ ai_gen_id }}">
            {% if block.settings.link_4_1_text != blank and block.settings.link_4_1_url != blank %}
              <li><a href="{{ block.settings.link_4_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_4_1_text }}</a></li>
            {% endif %}
            {% if block.settings.link_4_2_text != blank and block.settings.link_4_2_url != blank %}
              <li><a href="{{ block.settings.link_4_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_4_2_text }}</a></li>
            {% endif %}
            {% if block.settings.link_4_3_text != blank and block.settings.link_4_3_url != blank %}
              <li><a href="{{ block.settings.link_4_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_4_3_text }}</a></li>
            {% endif %}
            {% if block.settings.link_4_4_text != blank and block.settings.link_4_4_url != blank %}
              <li><a href="{{ block.settings.link_4_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.link_4_4_text }}</a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

    </div>

    <div class="ai-footer-bottom-{{ ai_gen_id }}">
      <div class="ai-footer-copyright-{{ ai_gen_id }}">
        {{ block.settings.copyright_text }}
      </div>
      {% if block.settings.show_payment_icons %}
        <div class="ai-footer-payment-{{ ai_gen_id }}">
          <span class="ai-footer-text-{{ ai_gen_id }}" style="margin-right: 8px;">{{ block.settings.payment_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</footer-block-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('footer-block-{{ ai_gen_id }}', FooterBlock{{ ai_gen_id }});
  })();
</script>


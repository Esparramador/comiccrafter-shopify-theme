<header class="cc-header">
  <div class="cc-header__inner">
    <a href="/" class="cc-header__logo">
      <img src="{{ 'logo-app.png' | asset_url }}" alt="{{ shop.name }}" />
      <span class="cc-header__logo-text">{{ shop.name }}</span>
    </a>

    <nav class="cc-header__nav">
      <a href="/" class="cc-header__link{% if template.name == 'index' %} cc-header__link--active{% endif %}">Inicio</a>
      <a href="/collections" class="cc-header__link{% if template.name == 'collection' %} cc-header__link--active{% endif %}">Tienda</a>
      <a href="/collections/suscripciones" class="cc-header__link">Planes</a>
      <a href="/collections/packs-de-creditos" class="cc-header__link">Créditos</a>
      <a href="/pages/sobre-comic-crafter" class="cc-header__link{% if page.handle == 'sobre-comic-crafter' %} cc-header__link--active{% endif %}">Sobre Nosotros</a>
      <a href="/pages/faq-preguntas-frecuentes" class="cc-header__link{% if page.handle == 'faq-preguntas-frecuentes' %} cc-header__link--active{% endif %}">FAQ</a>
      <a href="/pages/contacto" class="cc-header__link{% if page.handle == 'contacto' %} cc-header__link--active{% endif %}">Contacto</a>
    </nav>

    <div class="cc-header__actions">
      <a href="/cart" class="cc-header__cart" aria-label="Carrito">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cc-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
      {% if customer %}
        <a href="/account" class="cc-header__link cc-header__link--active" style="background:linear-gradient(135deg,var(--cc-purple),var(--cc-pink));color:#fff;padding:0.5rem 1rem;border-radius:var(--cc-radius-full);font-weight:700;font-size:0.8125rem;">Mi Cuenta</a>
      {% else %}
        <a href="/account/login" class="cc-header__link cc-header__link--active" style="background:linear-gradient(135deg,var(--cc-purple),var(--cc-pink));color:#fff;padding:0.5rem 1rem;border-radius:var(--cc-radius-full);font-weight:700;font-size:0.8125rem;">Iniciar Sesión</a>
      {% endif %}
      <button class="cc-header__menu-toggle" aria-label="Abrir menú" onclick="document.querySelector('.cc-mobile-menu').classList.toggle('active')">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<nav class="cc-mobile-menu">
  <a href="/" class="cc-mobile-menu__link">Inicio</a>
  <a href="/collections" class="cc-mobile-menu__link">Tienda</a>
  <a href="/collections/suscripciones" class="cc-mobile-menu__link">Planes</a>
  <a href="/collections/packs-de-creditos" class="cc-mobile-menu__link">Créditos</a>
  <a href="/pages/sobre-comic-crafter" class="cc-mobile-menu__link">Sobre Nosotros</a>
  <a href="/pages/faq-preguntas-frecuentes" class="cc-mobile-menu__link">FAQ</a>
  <a href="/pages/contacto" class="cc-mobile-menu__link">Contacto</a>
  {% if customer %}
    <a href="/account" class="cc-mobile-menu__link cc-mobile-menu__link--cta">Mi Cuenta</a>
  {% else %}
    <a href="/account/login" class="cc-mobile-menu__link cc-mobile-menu__link--cta">Iniciar Sesión</a>
  {% endif %}
</nav>
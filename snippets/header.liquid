<header class="cc-header">
  <div class="cc-header__inner">
    <a href="/" class="cc-header__logo">
      {% if settings.logo %}
        <img src="{{ settings.logo | image_url: width: 72 }}" alt="{{ shop.name }}" />
      {% else %}
        <img src="{{ 'logo-app.png' | asset_url }}" alt="{{ shop.name }}" style="width:36px;height:36px;border-radius:8px;" />
      {% endif %}
      <span class="cc-header__logo-text">{{ shop.name }}</span>
    </a>

    <nav class="cc-header__nav" role="navigation" id="main-nav">
      <a href="/collections/all" class="cc-header__link">Tienda</a>
      <a href="/collections/suscripciones" class="cc-header__link">Planes</a>
      <a href="/collections/packs-de-creditos" class="cc-header__link">Créditos</a>
      <a href="/pages/sobre-comic-crafter" class="cc-header__link">Sobre Nosotros</a>
      <a href="/pages/faq-preguntas-frecuentes" class="cc-header__link">FAQ</a>
    </nav>

    <div class="cc-header__actions">
      <a href="/cart" class="cc-header__cart" aria-label="Carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        {% if cart.item_count > 0 %}
          <span class="cc-header__cart-count">{{ cart.item_count }}</span>
        {% endif %}
      </a>

      {% if customer %}
        <a href="/account" class="cc-btn cc-btn--ghost cc-btn--sm">Mi Cuenta</a>
      {% else %}
        <a href="/account/login" class="cc-btn cc-btn--primary cc-btn--sm">Iniciar Sesión</a>
      {% endif %}

      <button class="cc-header__mobile-toggle" id="mobile-menu-toggle" aria-label="Menú">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <div class="cc-mobile-menu" id="mobile-menu">
    <a href="/collections/all" class="cc-mobile-menu__link">Tienda</a>
    <a href="/collections/suscripciones" class="cc-mobile-menu__link">Planes</a>
    <a href="/collections/packs-de-creditos" class="cc-mobile-menu__link">Créditos</a>
    <a href="/pages/sobre-comic-crafter" class="cc-mobile-menu__link">Sobre Nosotros</a>
    <a href="/pages/faq-preguntas-frecuentes" class="cc-mobile-menu__link">FAQ</a>
    <a href="/cart" class="cc-mobile-menu__link">Carrito ({{ cart.item_count }})</a>
    {% if customer %}
      <a href="/account" class="cc-mobile-menu__link">Mi Cuenta</a>
    {% else %}
      <a href="/account/login" class="cc-mobile-menu__link cc-mobile-menu__link--cta">Iniciar Sesión</a>
    {% endif %}
  </div>
</header>
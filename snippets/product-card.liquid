<a href="{{ product.url }}" class="cc-product-card" data-product-id="{{ product.id }}">
  <div class="cc-product-card__image">
    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        loading="lazy"
        width="600" height="600"
      />
    {% else %}
      <div class="cc-product-card__placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      </div>
    {% endif %}
    {% if product.compare_at_price > product.price %}
      <span class="cc-product-card__sale-badge">
        -{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
      </span>
    {% endif %}
    {% if product.available == false %}
      <span class="cc-product-card__sold-out">Agotado</span>
    {% endif %}
  </div>
  <div class="cc-product-card__info">
    {% if product.type != blank %}
      <span class="cc-product-card__type">{{ product.type }}</span>
    {% endif %}
    <h3 class="cc-product-card__title">{{ product.title }}</h3>
    <div class="cc-product-card__price-row">
      <span class="cc-product-card__price">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="cc-product-card__compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>
</a>
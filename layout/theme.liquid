<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#0B0D17">

  <title>
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

  {{ 'comic-crafter.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  {% if template.name == 'index' %}
    <style>
      .cc-hero { min-height: 80vh; }
    </style>
  {% endif %}
</head>
<body>
  <a href="#main-content" class="cc-sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% render 'gallery-background' %}

  {% section 'announcement-bar' %}
  {% render 'header' %}

  <main id="main-content" role="main" style="position: relative; z-index: 10;">
    {{ content_for_layout }}
  </main>

  {% render 'footer' %}

  <script src="{{ 'comic-crafter.js' | asset_url }}" defer></script>
<!-- Comic Crafter: Redirect Shopify login to app -->
<script>
(function() {
  var APP_URL = 'https://comiccrafter.es';
  var ACCOUNT_DOMAINS = ['account.comiccrafter.es', 'shopify.com/authentication'];

  function interceptLoginLinks() {
    document.querySelectorAll('a[href]').forEach(function(link) {
      var href = link.getAttribute('href') || '';
      var isLoginLink = href.includes('/account') || 
                        href.includes('account.comiccrafter.es') ||
                        href.includes('/authentication') ||
                        (href.includes('customer') && href.includes('login'));
      
      if (isLoginLink && !link.dataset.ccIntercepted) {
        link.dataset.ccIntercepted = 'true';
        link.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          window.location.href = APP_URL + '/login?from=shopify';
        });
      }
    });

    var buttons = document.querySelectorAll('button, [role="button"]');
    buttons.forEach(function(btn) {
      var text = (btn.textContent || '').toLowerCase().trim();
      if ((text.includes('iniciar sesi') || text.includes('sign in') || text.includes('log in') || text.includes('mi cuenta') || text.includes('my account')) && !btn.dataset.ccIntercepted) {
        btn.dataset.ccIntercepted = 'true';
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          window.location.href = APP_URL + '/login?from=shopify';
        });
      }
    });
  }

  function interceptAccountRedirects() {
    if (window.location.hostname === 'account.comiccrafter.es') {
      window.location.href = APP_URL + '/mis-pedidos';
      return;
    }
    var currentUrl = window.location.href;
    for (var i = 0; i < ACCOUNT_DOMAINS.length; i++) {
      if (currentUrl.includes(ACCOUNT_DOMAINS[i])) {
        window.location.href = APP_URL + '/login?from=shopify';
        return;
      }
    }
  }

  interceptAccountRedirects();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', interceptLoginLinks);
  } else {
    interceptLoginLinks();
  }

  var observer = new MutationObserver(function() { interceptLoginLinks(); });
  observer.observe(document.body || document.documentElement, { childList: true, subtree: true });
})();
</script>
</body>
</html>

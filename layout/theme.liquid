<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#0B0D17">

  <title>
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

  {{ 'comic-crafter.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  {% if template.name == 'index' %}
    <style>
      .cc-hero { min-height: 80vh; }
    </style>
  {% endif %}

<!-- Comic Crafter: Account page branding -->
<script>
(function() {
  if (window.location.hostname === 'account.comiccrafter.es' || document.referrer.includes('account.comiccrafter.es')) {
    var style = document.createElement('style');
    style.textContent = `
/* Comic Crafter — Customer Account Branding Override */
/* Applied via theme.liquid for account pages */
:root {
  --color-accent: #A855F7 !important;
  --color-interactive: #A855F7 !important;
  --color-primary-button: #A855F7 !important;
  --color-primary-button-text: #FFFFFF !important;
  --color-canvas: #06080F !important;
  --color-canvas-subdued: #0D1117 !important;
  --color-surface: #161B22 !important;
  --color-text: #F8FAFC !important;
  --color-text-subdued: #94A3B8 !important;
  --color-border: #1E293B !important;
  --font-family-base: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
}`;
    document.head.appendChild(style);
  }
})();
</script>
<!-- CC-FIX-START -->
<style>
.cc-mobile-menu{display:none!important;flex-direction:column;background:#111322;border-top:1px solid rgba(255,255,255,.05);padding:1rem;gap:.25rem;position:fixed;top:56px;left:0;right:0;z-index:999;box-shadow:0 8px 32px rgba(0,0,0,.6);max-height:calc(100vh - 56px);overflow-y:auto}
.cc-mobile-menu.active{display:flex!important}
</style>
<!-- CC-FIX-END -->
</head>
<body>
  <a href="#main-content" class="cc-sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% render 'gallery-background' %}

  {% section 'announcement-bar' %}
  {% render 'header' %}

  <main id="main-content" role="main" style="position: relative; z-index: 10;">
    {{ content_for_layout }}
  </main>

  {% render 'footer' %}

  <script src="{{ 'comic-crafter.js' | asset_url }}" defer></script>
</body>
</html>

